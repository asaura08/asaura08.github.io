---
interface Props {
  text: string;
  link: string;
  px?: number;
  py?: number;
}

const { text, px = 4, py = 2, link } = Astro.props;
---

<a href=`${link}`
  ><button
    type="button"
    class=`text-center font-medium focus:outline-none inline-flex items-center justify-center px-${px} py-${py} text-sm text-base text-gray-900 bg-white border border-gray-200  hover:text-primary-700 focus:text-primary-700 dark:focus:text-white dark:hover:text-white dark:bg-transparent dark:border-gray-300 dark:hover:border-violet-800 focus:ring-violet-800 dark:focus:ring-violet-800 rounded-lg dark:text-white dark:hover:bg-transparent dark:focus:border-violet-800 transition duration-100 ease-in-out hover:transform hover:scale-110`
    >{text}</button
  ></a
>
