---
import Layout from "../layout/Layout.astro";
import coding from "@assets/videos/dev-background.webm";
import sec from "@assets/videos/sec-background.webm";
import ops from "@assets/videos/ops-background.webm";
import secPoster from "@assets/images/secPoster.png";
---

<Layout title="Saura DevSecOps" footer={false} navbar={false}>
  <div class="flex w-full font-semibold text-10xl h-screen">
    <div class="video-container h-screen">
      <video id="dev-video" muted loop src={coding}></video>
      <a
        href="/dev"
        onmouseover="document.getElementById('dev-video').play();"
        onmouseout="document.getElementById('dev-video').load();"
        id="dev"></a>
    </div>
    <div class="video-container">
      <video id="sec-video" muted loop poster={secPoster.src} src={sec}></video>
      <a
        href="/sec"
        onmouseover="document.getElementById('sec-video').play();"
        onmouseout="document.getElementById('sec-video').load();"
        id="sec"></a>
    </div>
    <div class="video-container">
      <video id="ops-video" muted loop src={ops}></video>
      <a
        href="/ops"
        onmouseover="document.getElementById('ops-video').play();"
        onmouseout="document.getElementById('ops-video').load();"
        id="ops"></a>
    </div>
  </div>
</Layout>

<style>
  body {
    overflow: hidden;
  }

  .video-container {
    width: calc(100% / 3);
    position: relative;
    overflow: hidden;
    color: white;
    min-width: 10%;
    transition: 0.75s;
  }

  .video-container video {
    width: 100%;
    height: 100%;
    position: absolute;
    object-fit: cover;
    z-index: 0;
  }

  /* Just styling the content of the div, the *magic* in the previous rules */
  .video-container > a {
    z-index: 1;
    position: relative;
    font-size: 18rem;
    min-height: 100%;
    display: flex;
  }

  .video-container:hover {
    min-width: 74%;
  }
  .video-container > a:hover {
    justify-content: center;
  }

  .video-container:not(:hover) {
    min-width: 13%;
  }

  #dev:not(:hover)::before {
    content: "Dev";
  }

  #dev:hover::before {
    animation: dev-text 2s linear forwards;
    display: block;
    content: "Dev";
    font-size: 11rem;
  }

  #sec:not(:hover)::before {
    content: "Sec";
    padding: 0 2rem;
  }

  #ops:not(:hover)::before {
    content: "Ops";
  }

  #sec:hover::before {
    content: "Sec";
    font-size: 10rem;
    animation: sec-text 2s linear forwards;
  }

  #ops:hover::before {
    content: "Ops";
    font-size: 10rem;
    animation: ops-text 2s linear forwards;
  }

  @keyframes dev-text {
    26% {
      content: "Dev";
    }
    30% {
      content: "Deve";
    }
    36% {
      content: "Devel";
    }
    42% {
      content: "Develo";
    }
    48% {
      content: "Develop";
    }
    54% {
      content: "Developm";
    }
    60% {
      content: "Developme";
    }
    66% {
      content: "Developmen";
    }
    72% {
      content: "Development";
    }
    100% {
      content: "Development";
    }
  }

  @keyframes sec-text {
    26% {
      content: "Sec";
    }
    30% {
      content: "Secu";
    }
    36% {
      content: "Secur";
    }
    42% {
      content: "Securi";
    }
    48% {
      content: "Securit";
    }
    54% {
      content: "Security";
    }
    100% {
      content: "Security";
    }
  }

  @keyframes ops-text {
    26% {
      content: "Ops";
    }
    30% {
      content: "Ope";
    }
    36% {
      content: "Oper";
    }
    42% {
      content: "Opera";
    }
    48% {
      content: "Operat";
    }
    54% {
      content: "Operati";
    }
    60% {
      content: "Operatio";
    }
    66% {
      content: "Operation";
    }
    72% {
      content: "Operations";
    }
    100% {
      content: "Operations";
    }
  }
</style>
