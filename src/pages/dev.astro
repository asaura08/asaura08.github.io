---
import Layout from "src/layout/Layout.astro";
---

<Layout title="Development">
  <section id="Estadisticas ">
    <h2 class="text-center text-white">Estadisticas de tiempo de desarrollo</h2>
    <div class="flex flex-col justify-center py-8">
      <img
        class="mr-36"
        src="https://github-readme-stats.vercel.app/api/wakatime?username=elnegren&api_domain=wakapi.dev&langs_count=10&hide_border=true&card_width=300&theme=transparent&hide_title=true"
        alt="Estadisticas de tiempo de desarrollo"
      />
      <img
        class=""
        src="https://github-readme-stats.vercel.app/api?username=asaura08&show_icons=true&theme=transparent&rank_icon=github&hide_border=true&hide_title=true"
        alt=""
      />
    </div>
  </section>
</Layout>
